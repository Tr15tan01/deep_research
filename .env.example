# =====================================================================================
# Deep Research — environment configuration
#
# Copy to `.env` and fill in. Feature flags are strictly 1 (enabled) / 0 (disabled);
# any other value fails startup. Secrets are blank here on purpose — never commit `.env`.
# Production (APP_ENV=production|staging) refuses to start with missing mandatory secrets
# or unsafe settings (see docs/configuration.md for the full rule list).
# =====================================================================================

# --- Application -----------------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
APP_NAME=Deep Research
# https:// required in production; drives secure cookies + CORS
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
# where the Next.js server reaches FastAPI (e.g. http://api:8000 in Compose)
API_INTERNAL_URL=http://localhost:8000
# extra comma-separated origins; FRONTEND_URL is always allowed
CORS_ALLOWED_ORIGINS=
# reverse proxies whose X-Forwarded-For is trusted for rate limiting
TRUSTED_PROXY_HOPS=1
# set only if the API and web share a parent domain
COOKIE_DOMAIN=

# --- Storage ---------------------------------------------------------------------------
# MongoDB Atlas: mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Local Compose: mongodb://mongo:27017/?replicaSet=rs0
# Development only: mongomock:// (in-memory, per-process, NOT durable — requires EMBEDDED_WORKER=1)
MONGODB_URI=
MONGODB_DATABASE=deep_research
# e.g. redis://localhost:6379/0 — required in production
REDIS_URL=
UPLOAD_DIR=/var/lib/deep-research/uploads

# --- Authentication --------------------------------------------------------------------
# >= 32 random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# comma-separated; these accounts become ADMIN once their email is verified
# (only the in-memory development database skips the verification requirement)
ADMIN_BOOTSTRAP_EMAILS=

# 0 removes Google sign-in entirely (UI and endpoints)
GOOGLE_AUTH_ENABLED=0
GOOGLE_CLIENT_ID=
# redirect URI to register: {FRONTEND_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_SECRET=

# Email verification: EMAIL_VERIFICATION_ENABLED is canonical. REQUIRE_EMAIL_VERIFICATION is a
# compatibility alias consulted only when the canonical flag is unset; if both are set and
# disagree, EMAIL_VERIFICATION_ENABLED wins and a startup warning is logged.
EMAIL_VERIFICATION_ENABLED=0
REQUIRE_EMAIL_VERIFICATION=
PASSWORD_RESET_ENABLED=1
# required in production when verification or password reset is on
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=1
# e.g. "Deep Research <no-reply@example.com>"
EMAIL_FROM=

# --- AI providers (server-side only; never exposed to the browser) ----------------------
# gemini | openai | anthropic | openai_compatible | demo
AI_PROVIDER=gemini
# exact model ID as listed by the provider (admins can change this in /admin/providers)
AI_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# e.g. https://my-gateway.example.com/v1
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# uses the explicitly configured fallback model only; every switch is recorded
AI_FALLBACK_ENABLED=1
AI_REQUEST_TIMEOUT_SECONDS=120

# --- Search & extraction ----------------------------------------------------------------
# firecrawl | tavily | brave | demo
SEARCH_PROVIDER=firecrawl
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# fall back across configured providers; the producing provider is recorded per result
SEARCH_FALLBACK_ENABLED=1
SEARCH_CACHE_TTL_SECONDS=21600
# OpenAlex (keyless) for Academic Literature Review
SCHOLARLY_SEARCH_ENABLED=1
# optional contact email for OpenAlex's polite pool
OPENALEX_MAILTO=
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_BYTES=5242880
# SSRF guard: outbound fetches to other ports are refused
FETCH_ALLOWED_PORTS=80,443

# --- Billing (optional module, off by default) ------------------------------------------
BILLING_ENABLED=0
BILLING_PROVIDER=paddle
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# sandbox | production
PADDLE_ENVIRONMENT=sandbox
# e.g. pro:pri_123,team:pri_456
PADDLE_PRICE_IDS=
BILLING_GRACE_DAYS=7
# whether past-due subscribers may start new research during grace
BILLING_GRACE_ALLOWS_NEW_JOBS=1

# --- Product flags ------------------------------------------------------------------------
PUBLIC_SIGNUP_ENABLED=1
# users choose among admin-approved models
ALLOW_USER_MODEL_SELECTION=1
# bring-your-own-key (encrypted with ENCRYPTION_KEYS)
ALLOW_USER_API_KEYS=0
# 1 = synthetic, clearly labelled demo provider; refused in production
DEMO_MODE=0
# demo pacing so the live view is observable (e.g. 700)
DEMO_STEP_DELAY_MS=0
RATE_LIMIT_ENABLED=1
AUDIT_LOG_ENABLED=1
# optional moderation only; auth, isolation and SSRF protection are always on
CONTENT_SAFETY_ENABLED=1
FILE_UPLOADS_ENABLED=1
CHARTS_ENABLED=1
PUBLIC_REPORT_SHARING_ENABLED=0
# run research jobs inside the API process (development, or single-service hosting such as Render free tier)
EMBEDDED_WORKER=0
# when set (>= 32 chars), only callers sending it as X-Internal-Token (the web proxy) can use the API;
# set the same value for the web app. Use it whenever the API has a public URL.
INTERNAL_PROXY_TOKEN=

# --- Limits (enforced server-side) --------------------------------------------------------
MAX_CONCURRENT_RESEARCH_JOBS_PER_USER=2
MAX_RESEARCH_DURATION_SECONDS=1800
MAX_SEARCH_CALLS_PER_JOB=25
MAX_SOURCES_PER_JOB=30
MAX_TOOL_CALLS_PER_JOB=60
MAX_OUTPUT_TOKENS_PER_JOB=20000
# automatic retries before dead-lettering
MAX_JOB_ATTEMPTS=5
DAILY_RESEARCH_JOBS_PER_USER=30
# estimated cost from the admin pricing table
MONTHLY_COST_LIMIT_USD_PER_USER=25
MAX_FILE_SIZE_MB=20
MAX_RESEARCH_UPLOADS_PER_JOB=10
UPLOAD_RETENTION_DAYS=30

# --- At-rest encryption for stored provider credentials -----------------------------------
# Comma-separated urlsafe-base64 32-byte keys; the first encrypts, all decrypt (rotation).
# python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEYS=

# --- Worker ---------------------------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_POLL_SECONDS=5
WORKER_HEALTH_FILE=/tmp/deep-research-worker.alive

# --- Optional malware scanning of uploads (clamd) -------------------------------------------
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Observability ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# blank = JSON in production, pretty in development
LOG_JSON=
# Sentry-protocol DSN; requires `pip install deep-research-api[tracking]`
ERROR_TRACKING_DSN=
